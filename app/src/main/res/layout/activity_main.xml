<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="CYBER CORE INTERFACE"
            app:titleCentered="true"
            app:titleTextColor="@color/neon_pink"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Cyber Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="24dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/neon_cyan"
                app:cardBackgroundColor="#1AFFFFFF"> <!-- Glassmorphism effect -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM TELEMETRY"
                        android:textAllCaps="true"
                        android:textColor="@color/glass_border"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.4" />

                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="STABLE"
                        android:textAlignment="center"
                        android:textColor="@color/neon_cyan"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="@color/neon_blue"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="15" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Command Terminal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="COMMAND TERMINAL"
                android:textColor="@color/neon_pink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.25" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackgroundTask"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="18dp"
                android:text="INVOKE BACKGROUND"
                android:textAllCaps="true"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_rotate"
                app:backgroundTint="@color/neon_blue"
                app:iconSize="32dp"
                app:rippleColor="#80FFFFFF"
                app:elevation="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForegroundService"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="18dp"
                android:text="ENGAGE FOREGROUND"
                android:textAllCaps="true"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_dialog_info"
                app:backgroundTint="@color/neon_green"
                app:iconSize="32dp"
                app:rippleColor="#80FFFFFF"
                app:elevation="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBindService"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="18dp"
                android:text="ESTABLISH NEURAL LINK"
                android:textAllCaps="true"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_share"
                app:backgroundTint="@color/neon_purple"
                app:iconSize="32dp"
                app:rippleColor="#80FFFFFF"
                app:elevation="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnbindService"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:text="ABORT CONNECTION"
                android:textAllCaps="true"
                android:textColor="@color/neon_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="24dp"
                app:strokeColor="@color/neon_red"
                app:strokeWidth="4dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/neon_red"
                app:iconSize="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>