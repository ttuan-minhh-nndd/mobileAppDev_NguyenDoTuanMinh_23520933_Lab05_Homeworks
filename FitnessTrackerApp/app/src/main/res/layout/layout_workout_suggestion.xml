<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/gym_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_suggestion_card">

        <TextView
            android:id="@+id/tvAiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ELITE AI COACH"
            android:textColor="@color/gym_neon_green"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSuggestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Analyzing biometric data..."
            android:textColor="@color/gym_white"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEncouragement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pushing the limits."
            android:textColor="@color/gym_electric_blue"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
